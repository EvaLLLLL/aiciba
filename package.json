{
  "name": "aiciba",
  "version": "1.0.9",
  "description": "A CLI dictionary for any two languages, powered by AI",
  "bin": {
    "ciba": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsup",
    "build:workflow": "tsup && node scripts/build-workflow.mjs",
    "icon:workflow": "rsvg-convert -w 512 -h 512 -o workflow/icon.png workflow/icon.svg",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/*/*.test.ts",
    "postinstall": "node scripts/run-postinstall.mjs",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts/run-postinstall.mjs",
    "README.md"
  ],
  "keywords": [
    "cli",
    "dictionary",
    "ai",
    "english",
    "chinese"
  ],
  "author": "Yuhao Liu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvaLLLLL/aiciba.git"
  },
  "homepage": "https://github.com/EvaLLLLL/aiciba",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@clack/prompts": "^1.1.0",
    "ai": "^6.0.116",
    "chalk": "^5.6.2",
    "dotenv": "^16.5.0",
    "zod": "^4.3.6"
  }
}
